{
  "name": "mrembiasz-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "lint:frontend": "npm run lint:frontend:format && npm run lint:frontend:code && npm run lint:frontend:types",
    "lint:frontend:format": "prettier --check \"src/**/*.{astro,css,js,mjs}\" \"*.{js,mjs,json}\"",
    "lint:frontend:code": "eslint .",
    "lint:frontend:types": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "scan:frontend:packages": "npm audit --audit-level=high",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.0.7",
    "rehype-mermaid": "^3.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.7.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
