---
import { getCollection } from "astro:content";
import "../styles/global.css";
import "../styles/index.css";

const deployId = import.meta.env.PUBLIC_DEPLOY_ID ?? "local";

const posts = (await getCollection("blog")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Production notes by Mateusz Rembiasz on AWS, infrastructure, CI/CD, and serverless systems."
    />
    <meta name="deploy-id" content={deployId} />
    <title>Mateusz Rembiasz Blog</title>
  </head>
  <body>
    <main class="container">
      <h1 class="name">Mateusz Rembiasz Blog</h1>
      <p class="bio">
        Hi! :) Welcome to my blog! I write about AWS, infrastructure, CI/CD, and
        serverless systems. You can also check my <a href="https://mrembiasz.pl"
          >portfolio</a
        > for more information about me.
      </p>

      <section class="section" aria-labelledby="posts-title">
        <p id="posts-title" class="section-label">Latest</p>
        <div class="posts">
          {
            posts.map((post) => (
              <a class="post" href={`/posts/${post.id}/`}>
                <div class="post-header">
                  <h2>{post.data.title}</h2>
                  <time datetime={post.data.date}>{post.data.date}</time>
                </div>
                <p>{post.data.summary}</p>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>
