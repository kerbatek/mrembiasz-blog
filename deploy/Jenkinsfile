pipeline {
  agent {
    kubernetes {
      defaultContainer 'node'
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: node
      image: node:24-alpine
      command:
        - cat
      tty: true
    - name: terraform
      image: hashicorp/terraform:1.13
      command:
        - cat
      tty: true
    - name: aws
      image: amazon/aws-cli:2.28.21
      command:
        - cat
      tty: true
'''
    }
  }

  environment {
    AWS_ROLE_ARN = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
    TF_IN_AUTOMATION = 'true'
  }

  stages {
    stage('Build Astro') {
      steps {
        sh 'npm ci'
        sh 'npm run build'
      }
    }

    stage('Terraform Plan') {
      steps {
        container('terraform') {
          withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
            sh 'deploy/scripts/terraform-plan.sh'
          }
        }
      }
    }

    stage('Terraform Apply') {
      when {
        branch 'main'
      }
      steps {
        container('terraform') {
          withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
            sh 'deploy/scripts/terraform-apply.sh'
          }
        }
      }
    }

    stage('Deploy Static Site') {
      when {
        branch 'main'
      }
      steps {
        container('aws') {
          withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
            sh 'deploy/scripts/deploy-static-site.sh'
          }
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'dist/**, terraform/tfplan, terraform/tfplan.txt', fingerprint: true
    }
  }
}
