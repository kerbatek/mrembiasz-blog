def PLAN_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-plan'
def DEPLOY_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
def pipelineHelpers

pipeline {
  agent {
    kubernetes {
      defaultContainer 'node'
      yamlFile 'deploy/jenkins/plan-pod.yaml'
    }
  }

  environment {
    TF_IN_AUTOMATION = 'true'
  }

  options {
    disableConcurrentBuilds()
  }

  stages {
    stage('Initialize') {
      steps {
        script {
          pipelineHelpers = load 'deploy/jenkins/pipeline-helpers.groovy'
        }
      }
    }

    stage('Validate') {
      parallel {
        stage('Frontend') {
          stages {
            stage('Install Frontend Dependencies') {
              steps {
                script {
                  pipelineHelpers.checkedSh(name: 'Install Frontend Dependencies', checkName: 'Frontend', exec: 'npm ci')
                }
              }
            }

            stage('Scan Frontend Packages') {
              steps {
                script {
                  pipelineHelpers.checkedSh(name: 'Scan Frontend Packages', checkName: 'Frontend', exec: 'npm run scan:frontend:packages')
                }
              }
            }

            stage('Lint Frontend') {
              steps {
                script {
                  pipelineHelpers.checkedSh(name: 'Lint Frontend', checkName: 'Frontend', exec: 'npm run lint:frontend')
                }
              }
            }

            stage('Build Astro') {
              environment {
                PUBLIC_DEPLOY_ID = "${env.GIT_COMMIT ?: 'local'}"
              }
              steps {
                script {
                  pipelineHelpers.checkedSh(name: 'Build Astro', checkName: 'Frontend', exec: 'npm run build')
                }
              }
            }
          }
        }

        stage('Backend') {
          stages {
            stage('Download Backend Dependencies') {
              steps {
                container('go') {
                  script {
                    pipelineHelpers.checkedSh(name: 'Download Backend Dependencies', checkName: 'Backend', exec: 'deploy/scripts/download-backend-dependencies.sh')
                  }
                }
              }
            }

            stage('Run Backend Tests') {
              steps {
                container('go') {
                  script {
                    pipelineHelpers.checkedSh(name: 'Run Backend Tests', checkName: 'Backend', exec: 'deploy/scripts/test-backend-lambdas.sh')
                  }
                }
              }
            }

            stage('Build Go Lambdas') {
              steps {
                container('go') {
                  script {
                    pipelineHelpers.checkedSh(name: 'Build Go Lambdas', checkName: 'Backend', exec: 'deploy/scripts/build-backend-lambdas.sh')
                  }
                }
              }
            }
          }
        }
      }
    }

    stage('SonarQube') {
      stages {
        stage('Frontend Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedSonarScan(name: 'SonarQube Frontend Scan', checkName: 'Frontend', component: 'frontend')
              }
            }
          }
        }

        stage('Frontend Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedQualityGate(name: 'SonarQube Frontend Quality Gate', checkName: 'Frontend', component: 'frontend')
              }
            }
          }
        }

        stage('Backend Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedSonarScan(name: 'SonarQube Backend Scan', checkName: 'Backend', component: 'backend')
              }
            }
          }
        }

        stage('Backend Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedQualityGate(name: 'SonarQube Backend Quality Gate', checkName: 'Backend', component: 'backend')
              }
            }
          }
        }

        stage('Terraform Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedSonarScan(name: 'SonarQube Terraform Scan', checkName: 'SonarQube Terraform', component: 'terraform')
              }
            }
          }
        }

        stage('Terraform Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                pipelineHelpers.checkedQualityGate(name: 'SonarQube Terraform Quality Gate', checkName: 'SonarQube Terraform', component: 'terraform')
              }
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      when {
        expression { currentBuild.currentResult == 'SUCCESS' }
      }
      steps {
        script {
          pipelineHelpers.checkedAwsSh(
            name: 'Terraform Plan',
            checkName: 'Terraform Plan',
            container: 'terraform',
            role: PLAN_ROLE,
            exec: 'deploy/scripts/terraform-plan.sh',
            titleFile: 'terraform/tfplan-summary.txt'
          )
        }
      }
    }

    stage('Package Release Artifacts') {
      when {
        allOf {
          branch 'main'
          expression { currentBuild.currentResult == 'SUCCESS' }
        }
      }
      steps {
        script {
          env.RELEASE_ARTIFACT_SHA256 = sh(
            script: 'deploy/scripts/package-release-artifacts.sh',
            returnStdout: true
          ).trim()
        }
        stash name: 'release-artifacts', includes: 'release-artifacts.tar.gz'
      }
    }

    stage('Release') {
      agent {
        kubernetes {
          defaultContainer 'tools'
          yamlFile 'deploy/jenkins/release-pod.yaml'
        }
      }
      when {
        beforeAgent true
        allOf {
          branch 'main'
          expression { currentBuild.currentResult == 'SUCCESS' }
        }
      }
      stages {
        stage('Verify Release Artifacts') {
          steps {
            deleteDir()
            checkout scm
            unstash 'release-artifacts'
            sh 'deploy/scripts/restore-release-artifacts.sh'
          }
        }

        stage('Terraform Apply') {
          steps {
            script {
              pipelineHelpers.checkedAwsSh(
                name: 'Terraform Apply',
                checkName: 'Release',
                container: 'terraform',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/terraform-apply.sh'
              )
            }
          }
        }

        stage('Deploy Backend Lambdas') {
          steps {
            script {
              pipelineHelpers.checkedAwsSh(
                name: 'Deploy Backend Lambdas',
                checkName: 'Release',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-backend-lambdas.sh'
              )
            }
          }
        }

        stage('Deploy Static Site') {
          steps {
            script {
              pipelineHelpers.checkedAwsSh(
                name: 'Deploy Static Site',
                checkName: 'Release',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-static-site.sh'
              )
            }
          }
        }

        stage('Smoke Test Website') {
          steps {
            script {
              pipelineHelpers.checkedSh(name: 'Smoke Test Website', checkName: 'Release', exec: 'deploy/scripts/smoke-test-site.sh')
            }
          }
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'dist/**, terraform/tfplan.txt, terraform/tfplan-summary.txt', fingerprint: true
    }
  }
}
