def PLAN_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-plan'
def DEPLOY_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
def githubCheck(String name, Closure body) {
  publishChecks(
    name: name,
    status: 'IN_PROGRESS',
    summary: 'Running',
    detailsURL: env.BUILD_URL
  )

  try {
    def checkResult = body.call()
    def checkTitle = null
    def checkSummary = 'Passed'
    def checkText = null

    if (checkResult instanceof Map) {
      checkTitle = checkResult.title ?: checkTitle
      checkSummary = checkResult.summary ?: checkSummary
      checkText = checkResult.text
    } else if (checkResult) {
      checkSummary = checkResult
    }

    def checkArgs = [
      name: name,
      status: 'COMPLETED',
      conclusion: 'SUCCESS',
      summary: checkSummary,
      detailsURL: env.BUILD_URL
    ]

    if (checkTitle) {
      checkArgs.title = checkTitle
    }

    if (checkText) {
      checkArgs.text = checkText
    }

    publishChecks checkArgs
  } catch (error) {
    publishChecks(
      name: name,
      status: 'COMPLETED',
      conclusion: 'FAILURE',
      summary: 'Failed',
      text: error.getMessage(),
      detailsURL: env.BUILD_URL
    )
    throw error
  }
}

def checkedSh(Map args) {
  githubCheck(args.checkName ?: args.name) {
    sh args.exec
    def result = [
      summary: args.name
    ]
    if (args.titleFile) {
      result.title = readFile(args.titleFile).trim()
    }
    if (args.textFile) {
      result.text = readFile(args.textFile).trim()
    }
    return result
  }
}

def withAwsRole(String containerName, String roleArn, Closure body) {
  container(containerName) {
    withEnv(["AWS_ROLE_ARN=${roleArn}", 'AWS_DEFAULT_REGION=eu-central-1']) {
      withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
        body.call()
      }
    }
  }
}

def checkedAwsSh(Map args) {
  withAwsRole(args.container, args.role) {
    checkedSh(name: args.name, checkName: args.checkName, exec: args.exec, titleFile: args.titleFile)
  }
}

def checkedSonarScan(Map args) {
  container('sonarqube') {
    withSonarQubeEnv('SonarQube') {
      checkedSh(
        name: args.name,
        checkName: args.checkName,
        exec: "deploy/scripts/sonarqube-scan.sh ${args.component}",
        textFile: "sonar-${args.component}-dashboard-url.txt"
      )
    }
  }
}

def checkedQualityGate(Map args) {
  githubCheck(args.checkName) {
    def dashboardUrlFile = "sonar-${args.component}-dashboard-url.txt"
    if (!fileExists(dashboardUrlFile)) {
      return "${args.name}: skipped because scan failed."
    }
    def qualityGate = waitForQualityGate abortPipeline: true
    return [
      summary: "${args.name}: ${qualityGate.status}",
      text: readFile(dashboardUrlFile).trim()
    ]
  }
}

pipeline {
  agent {
    kubernetes {
      defaultContainer 'node'
      yamlFile 'deploy/jenkins/agent-pod.yaml'
    }
  }

  environment {
    TF_IN_AUTOMATION = 'true'
  }

  options {
    disableConcurrentBuilds()
  }

  stages {
    stage('Validate') {
      parallel {
        stage('Frontend') {
          stages {
            stage('Install Frontend Dependencies') {
              steps {
                script {
                  checkedSh(name: 'Install Frontend Dependencies', checkName: 'Frontend', exec: 'npm ci')
                }
              }
            }

            stage('Scan Frontend Packages') {
              steps {
                script {
                  checkedSh(name: 'Scan Frontend Packages', checkName: 'Frontend', exec: 'npm run scan:frontend:packages')
                }
              }
            }

            stage('Lint Frontend') {
              steps {
                script {
                  checkedSh(name: 'Lint Frontend', checkName: 'Frontend', exec: 'npm run lint:frontend')
                }
              }
            }

            stage('Build Astro') {
              steps {
                script {
                  checkedSh(name: 'Build Astro', checkName: 'Frontend', exec: 'PUBLIC_DEPLOY_ID="${GIT_COMMIT:-local}" npm run build')
                }
              }
            }
          }
        }

        stage('Backend') {
          stages {
            stage('Download Backend Dependencies') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Download Backend Dependencies', checkName: 'Backend', exec: 'deploy/scripts/download-backend-dependencies.sh')
                  }
                }
              }
            }

            stage('Run Backend Tests') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Run Backend Tests', checkName: 'Backend', exec: 'deploy/scripts/test-backend-lambdas.sh')
                  }
                }
              }
            }

            stage('Build Go Lambdas') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Build Go Lambdas', checkName: 'Backend', exec: 'deploy/scripts/build-backend-lambdas.sh')
                  }
                }
              }
            }
          }
        }
      }
    }

    stage('SonarQube') {
      stages {
        stage('Frontend Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedSonarScan(name: 'SonarQube Frontend Scan', checkName: 'Frontend', component: 'frontend')
              }
            }
          }
        }

        stage('Frontend Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedQualityGate(name: 'SonarQube Frontend Quality Gate', checkName: 'Frontend', component: 'frontend')
              }
            }
          }
        }

        stage('Backend Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedSonarScan(name: 'SonarQube Backend Scan', checkName: 'Backend', component: 'backend')
              }
            }
          }
        }

        stage('Backend Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedQualityGate(name: 'SonarQube Backend Quality Gate', checkName: 'Backend', component: 'backend')
              }
            }
          }
        }

        stage('Terraform Scan') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedSonarScan(name: 'SonarQube Terraform Scan', checkName: 'SonarQube Terraform', component: 'terraform')
              }
            }
          }
        }

        stage('Terraform Quality Gate') {
          steps {
            script {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                checkedQualityGate(name: 'SonarQube Terraform Quality Gate', checkName: 'SonarQube Terraform', component: 'terraform')
              }
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      when {
        expression { currentBuild.currentResult == 'SUCCESS' }
      }
      steps {
        script {
          checkedAwsSh(
            name: 'Terraform Plan',
            checkName: 'Terraform Plan',
            container: 'terraform',
            role: PLAN_ROLE,
            exec: 'deploy/scripts/terraform-plan.sh',
            titleFile: 'terraform/tfplan-summary.txt'
          )
        }
      }
    }

    stage('Release') {
      when {
        allOf {
          branch 'main'
          expression { currentBuild.currentResult == 'SUCCESS' }
        }
      }
      stages {
        stage('Terraform Apply') {
          steps {
            script {
              checkedAwsSh(
                name: 'Terraform Apply',
                checkName: 'Release',
                container: 'terraform',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/terraform-apply.sh',
                titleFile: 'terraform/tfplan-summary.txt'
              )
            }
          }
        }

        stage('Deploy Backend Lambdas') {
          steps {
            script {
              checkedAwsSh(
                name: 'Deploy Backend Lambdas',
                checkName: 'Release',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-backend-lambdas.sh'
              )
            }
          }
        }

        stage('Deploy Static Site') {
          steps {
            script {
              checkedAwsSh(
                name: 'Deploy Static Site',
                checkName: 'Release',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-static-site.sh'
              )
            }
          }
        }

        stage('Smoke Test Website') {
          steps {
            script {
              checkedSh(name: 'Smoke Test Website', checkName: 'Release', exec: 'deploy/scripts/smoke-test-site.sh')
            }
          }
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'dist/**, terraform/tfplan.txt, terraform/tfplan-summary.txt', fingerprint: true
    }
  }
}
