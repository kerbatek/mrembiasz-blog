def PLAN_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-plan'
def DEPLOY_ROLE = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
def githubCheck(String name, Closure body) {
  publishChecks(
    name: name,
    status: 'IN_PROGRESS',
    summary: 'Running',
    detailsURL: env.BUILD_URL
  )

  try {
    def checkResult = body.call()
    def checkTitle = null
    def checkSummary = 'Passed'
    def checkText = null

    if (checkResult instanceof Map) {
      checkTitle = checkResult.title ?: checkTitle
      checkSummary = checkResult.summary ?: checkSummary
      checkText = checkResult.text
    } else if (checkResult) {
      checkSummary = checkResult
    }

    def checkArgs = [
      name: name,
      status: 'COMPLETED',
      conclusion: 'SUCCESS',
      summary: checkSummary,
      detailsURL: env.BUILD_URL
    ]

    if (checkTitle) {
      checkArgs.title = checkTitle
    }

    if (checkText) {
      checkArgs.text = checkText
    }

    publishChecks checkArgs
  } catch (error) {
    publishChecks(
      name: name,
      status: 'COMPLETED',
      conclusion: 'FAILURE',
      summary: 'Failed',
      text: error.getMessage(),
      detailsURL: env.BUILD_URL
    )
    throw error
  }
}

def checkedSh(Map args) {
  githubCheck(args.name) {
    sh args.exec
    if (args.titleFile) {
      return [
        title: readFile(args.titleFile).trim()
      ]
    }
  }
}

def withAwsRole(String containerName, String roleArn, Closure body) {
  container(containerName) {
    withEnv(["AWS_ROLE_ARN=${roleArn}", 'AWS_DEFAULT_REGION=eu-central-1']) {
      withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
        body.call()
      }
    }
  }
}

def checkedAwsSh(Map args) {
  withAwsRole(args.container, args.role) {
    checkedSh(name: args.name, exec: args.exec, titleFile: args.titleFile)
  }
}

def checkedQualityGate(String name) {
  githubCheck(name) {
    def qualityGate = waitForQualityGate abortPipeline: true
    return "Quality Gate: ${qualityGate.status}"
  }
}

pipeline {
  agent {
    kubernetes {
      defaultContainer 'node'
      yamlFile 'deploy/jenkins/agent-pod.yaml'
    }
  }

  environment {
    TF_IN_AUTOMATION = 'true'
  }

  options {
    disableConcurrentBuilds()
  }

  stages {
    stage('Validate') {
      parallel {
        stage('Frontend') {
          stages {
            stage('Install Frontend Dependencies') {
              steps {
                script {
                  checkedSh(name: 'Install Frontend Dependencies', exec: 'npm ci')
                }
              }
            }

            stage('Scan Frontend Packages') {
              steps {
                script {
                  checkedSh(name: 'Scan Frontend Packages', exec: 'npm run scan:frontend:packages')
                }
              }
            }

            stage('Lint Frontend') {
              steps {
                script {
                  checkedSh(name: 'Lint Frontend', exec: 'npm run lint:frontend')
                }
              }
            }

            stage('Build Astro') {
              steps {
                script {
                  checkedSh(name: 'Build Astro', exec: 'PUBLIC_DEPLOY_ID="${GIT_COMMIT:-local}" npm run build')
                }
              }
            }
          }
        }

        stage('Backend') {
          stages {
            stage('Download Backend Dependencies') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Download Backend Dependencies', exec: 'deploy/scripts/download-backend-dependencies.sh')
                  }
                }
              }
            }

            stage('Run Backend Tests') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Run Backend Tests', exec: 'deploy/scripts/test-backend-lambdas.sh')
                  }
                }
              }
            }

            stage('Build Go Lambdas') {
              steps {
                container('go') {
                  script {
                    checkedSh(name: 'Build Go Lambdas', exec: 'deploy/scripts/build-backend-lambdas.sh')
                  }
                }
              }
            }
          }
        }
      }
    }

    stage('SonarQube Scan') {
      steps {
        container('sonarqube') {
          script {
            withSonarQubeEnv('SonarQube') {
              checkedSh(name: 'SonarQube Scan', exec: 'sonar-scanner -Dsonar.projectVersion="${GIT_COMMIT:-local}"')
            }
          }
        }
      }
    }

    stage('SonarQube Quality Gate') {
      steps {
        script {
          checkedQualityGate('SonarQube Quality Gate')
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        script {
          checkedAwsSh(
            name: 'Terraform Plan',
            container: 'terraform',
            role: PLAN_ROLE,
            exec: 'deploy/scripts/terraform-plan.sh',
            titleFile: 'terraform/tfplan-summary.txt'
          )
        }
      }
    }

    stage('Release') {
      when {
        branch 'main'
      }
      stages {
        stage('Terraform Apply') {
          steps {
            script {
              checkedAwsSh(
                name: 'Terraform Apply',
                container: 'terraform',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/terraform-apply.sh',
                titleFile: 'terraform/tfplan-summary.txt'
              )
            }
          }
        }

        stage('Deploy Backend Lambdas') {
          steps {
            script {
              checkedAwsSh(
                name: 'Deploy Backend Lambdas',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-backend-lambdas.sh'
              )
            }
          }
        }

        stage('Deploy Static Site') {
          steps {
            script {
              checkedAwsSh(
                name: 'Deploy Static Site',
                container: 'aws',
                role: DEPLOY_ROLE,
                exec: 'deploy/scripts/deploy-static-site.sh'
              )
            }
          }
        }

        stage('Smoke Test Website') {
          steps {
            script {
              checkedSh(name: 'Smoke Test Website', exec: 'deploy/scripts/smoke-test-site.sh')
            }
          }
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'dist/**, terraform/tfplan.txt, terraform/tfplan-summary.txt', fingerprint: true
    }
  }
}
