def githubCheck(String name, Closure body) {
  publishChecks name: name,
    status: 'IN_PROGRESS',
    title: name,
    summary: 'Running',
    detailsURL: env.BUILD_URL

  try {
    def checkResult = body.call()
    def checkTitle = name
    def checkSummary = 'Passed'
    def checkText = null

    if (checkResult instanceof Map) {
      checkTitle = checkResult.title ?: checkTitle
      checkSummary = checkResult.summary ?: checkSummary
      checkText = checkResult.text
    } else if (checkResult) {
      checkSummary = checkResult
    }

    def checkArgs = [
      name: name,
      status: 'COMPLETED',
      conclusion: 'SUCCESS',
      title: checkTitle,
      summary: checkSummary,
      detailsURL: env.BUILD_URL
    ]

    if (checkText) {
      checkArgs.text = checkText
    }

    publishChecks checkArgs
  } catch (error) {
    publishChecks name: name,
      status: 'COMPLETED',
      conclusion: 'FAILURE',
      title: name,
      summary: 'Failed',
      text: error.getMessage(),
      detailsURL: env.BUILD_URL
    throw error
  }
}

pipeline {
  agent {
    kubernetes {
      defaultContainer 'node'
      yamlFile 'deploy/jenkins/agent-pod.yaml'
    }
  }

  environment {
    TF_IN_AUTOMATION = 'true'
  }

  options {
    disableConcurrentBuilds()
  }

  stages {
    stage('Validate') {
      parallel {
        stage('Frontend') {
          stages {
            stage('Install Frontend Dependencies') {
              steps {
                script {
                  githubCheck('Install Frontend Dependencies') {
                    sh 'npm ci'
                  }
                }
              }
            }

            stage('Scan Frontend Packages') {
              steps {
                script {
                  githubCheck('Scan Frontend Packages') {
                    sh 'npm run scan:frontend:packages'
                  }
                }
              }
            }

            stage('Lint Frontend') {
              steps {
                script {
                  githubCheck('Lint Frontend') {
                    sh 'npm run lint:frontend'
                  }
                }
              }
            }

            stage('Build Astro') {
              steps {
                script {
                  githubCheck('Build Astro') {
                    sh 'npm run build'
                  }
                }
              }
            }
          }
        }

        stage('Terraform Plan') {
          environment {
            AWS_ROLE_ARN = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-plan'
          }
          steps {
            container('terraform') {
              withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
                script {
                  githubCheck('Terraform Plan') {
                    sh 'deploy/scripts/terraform-plan.sh'
                    [
                      title: readFile('terraform/tfplan-summary.txt').trim(),
                      summary: readFile('terraform/tfplan-summary.txt').trim()
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }

    stage('Terraform Apply') {
      when {
        branch 'main'
      }
      environment {
        AWS_ROLE_ARN = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
      }
      steps {
        container('terraform') {
          withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
            script {
              githubCheck('Terraform Apply') {
                sh 'deploy/scripts/terraform-apply.sh'
              }
            }
          }
        }
      }
    }

    stage('Deploy Static Site') {
      when {
        branch 'main'
      }
      environment {
        AWS_ROLE_ARN = 'arn:aws:iam::047588357922:role/mrembiasz-blog-jenkins-deploy'
      }
      steps {
        container('aws') {
          withCredentials([file(credentialsId: 'aws-oidc-token', variable: 'AWS_WEB_IDENTITY_TOKEN_FILE')]) {
            script {
              githubCheck('Deploy Static Site') {
                sh 'deploy/scripts/deploy-static-site.sh'
              }
            }
          }
        }
      }
    }

    stage('Smoke Test Website') {
      when {
        branch 'main'
      }
      steps {
        container('node') {
          script {
            githubCheck('Smoke Test Website') {
              sh 'deploy/scripts/smoke-test-site.sh'
            }
          }
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'dist/**, terraform/tfplan, terraform/tfplan.txt, terraform/tfplan-summary.txt', fingerprint: true
    }
  }
}
